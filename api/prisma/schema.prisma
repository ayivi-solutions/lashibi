  fileAssetId     String
  fileAsset       FileAsset @relation(fields: [tenantId, fileAssetId], references: [tenantId, id], onDelete: Restrict)
  category        String?
  capturedAt      DateTime @default(now()) @db.Timestamptz(3)
  metadata        Json?

  @@index([tenantId, inspectionId])
  @@schema("lashibi")
}

model DamageRecord {
  id              String       @id @default(cuid())
