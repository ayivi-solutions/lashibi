  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  balances        StockBalance[]
  movements       StockMovement[]
  purchaseOrderLines PurchaseOrderLine[]

  @@unique([tenantId, id])
  @@unique([tenantId, sku])
  @@index([tenantId, oemNumber])
  @@schema("lashibi")
}

model StockLocation {
  id          String   @id @default(cuid())
  tenantId    String
  branchId    String
  branch      Branch   @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  code        String
  name        String
  active      Boolean  @default(true)

  balances    StockBalance[]
  movements   StockMovement[]

  @@unique([tenantId, id])
  @@unique([tenantId, branchId, code])
  @@schema("lashibi")
}

model StockBalance {
  tenantId    String
  partId      String
  part        Part          @relation(fields: [tenantId, partId], references: [tenantId, id], onDelete: Restrict)
  locationId  String
  location    StockLocation @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Restrict)
  onHand      Decimal       @default(0) @db.Decimal(18, 3)
  reserved    Decimal       @default(0) @db.Decimal(18, 3)
  available   Decimal       @default(0) @db.Decimal(18, 3)
  updatedAt   DateTime      @updatedAt @db.Timestamptz(3)

  @@id([tenantId, partId, locationId])
  @@schema("lashibi")
}

model StockMovement {
  id              String            @id @default(cuid())
  tenantId        String
  partId          String
  part            Part              @relation(fields: [tenantId, partId], references: [tenantId, id], onDelete: Restrict)
  locationId      String
  location        StockLocation     @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Restrict)
  type            StockMovementType
  quantity        Decimal           @db.Decimal(18, 3)
  unitCost        Decimal?          @db.Decimal(18, 2)
  sourceType      String
  sourceId        String
  performedById   String
  approvalRequestId String?
  occurredAt      DateTime          @default(now()) @db.Timestamptz(3)
  metadata        Json?

  @@index([tenantId, partId, occurredAt])
  @@index([tenantId, sourceType, sourceId])
  @@schema("lashibi")
}

model PurchaseOrder {
  id              String              @id @default(cuid())
  tenantId        String
  branchId        String
  supplierId      String
  supplier        Supplier            @relation(fields: [tenantId, supplierId], references: [tenantId, id], onDelete: Restrict)
  poCode          String
  status          PurchaseOrderStatus @default(DRAFT)
  currencyCode    String              @default("GHS") @db.VarChar(3)
  subtotal        Decimal             @default(0) @db.Decimal(18, 2)
  taxAmount       Decimal             @default(0) @db.Decimal(18, 2)
  totalAmount     Decimal             @default(0) @db.Decimal(18, 2)
  createdById     String
  approvalRequestId String?
  orderedAt       DateTime?           @db.Timestamptz(3)
  createdAt       DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime            @updatedAt @db.Timestamptz(3)

  lines           PurchaseOrderLine[]
  receipts        GoodsReceipt[]

  @@unique([tenantId, id])
  @@unique([tenantId, poCode])
  @@index([tenantId, supplierId, status])
  @@schema("lashibi")
}

model PurchaseOrderLine {
  id              String        @id @default(cuid())
  tenantId        String
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [tenantId, purchaseOrderId], references: [tenantId, id], onDelete: Restrict)
  partId          String
  part            Part          @relation(fields: [tenantId, partId], references: [tenantId, id], onDelete: Restrict)
  description     String
  quantity        Decimal       @db.Decimal(18, 3)
  unitCost        Decimal       @db.Decimal(18, 2)
  amount          Decimal       @db.Decimal(18, 2)

  @@index([tenantId, purchaseOrderId])
  @@schema("lashibi")
}

model GoodsReceipt {
  id              String             @id @default(cuid())
  tenantId        String
  purchaseOrderId String
  purchaseOrder   PurchaseOrder      @relation(fields: [tenantId, purchaseOrderId], references: [tenantId, id], onDelete: Restrict)
  receiptCode     String
  status          GoodsReceiptStatus @default(DRAFT)
  receivedById    String
  receivedAt      DateTime           @default(now()) @db.Timestamptz(3)
  postedAt        DateTime?          @db.Timestamptz(3)

  lines           GoodsReceiptLine[]

  @@unique([tenantId, id])
  @@unique([tenantId, receiptCode])
  @@schema("lashibi")
}

model GoodsReceiptLine {
  id              String       @id @default(cuid())
  tenantId        String
  goodsReceiptId  String
  goodsReceipt    GoodsReceipt @relation(fields: [tenantId, goodsReceiptId], references: [tenantId, id], onDelete: Restrict)
  purchaseOrderLineId String
  partId          String
  quantityReceived Decimal     @db.Decimal(18, 3)
  quantityRejected Decimal     @default(0) @db.Decimal(18, 3)
  notes           String?

  @@index([tenantId, goodsReceiptId])
  @@schema("lashibi")
}

