}

// =============================================================================
// INSURANCE / CLAIMS
// =============================================================================

model InsurancePolicy {
  id              String                @id @default(cuid())
  tenantId        String
  vehicleId       String
  vehicle         Vehicle               @relation(fields: [tenantId, vehicleId], references: [tenantId, id], onDelete: Restrict)
  insurerName     String
  policyNumber    String
  policyType      String
  status          InsurancePolicyStatus @default(ACTIVE)
  validFrom       DateTime              @db.Date
  validTo         DateTime              @db.Date
  premiumAmount   Decimal?              @db.Decimal(18, 2)
  excessAmount    Decimal?              @db.Decimal(18, 2)
  classification  Classification        @default(RESTRICTED)
  createdAt       DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime              @updatedAt @db.Timestamptz(3)

  claims          InsuranceClaim[]

  @@unique([tenantId, id])
  @@unique([tenantId, policyNumber])
  @@index([tenantId, vehicleId, status, validTo])
  @@schema("lashibi")
}

model InsuranceClaim {
  id              String               @id @default(cuid())
  tenantId        String
  vehicleId       String
  vehicle         Vehicle              @relation(fields: [tenantId, vehicleId], references: [tenantId, id], onDelete: Restrict)
  policyId        String?
  policy          InsurancePolicy?     @relation(fields: [tenantId, policyId], references: [tenantId, id], onDelete: Restrict)
  claimCode       String
  insurerClaimRef String?
  status          InsuranceClaimStatus @default(FNOL)
  incidentAt      DateTime             @db.Timestamptz(3)
  description     String
  estimatedAmount Decimal?             @db.Decimal(18, 2)
  approvedAmount  Decimal?             @db.Decimal(18, 2)
  settledAmount   Decimal?             @db.Decimal(18, 2)
  classification  Classification       @default(RESTRICTED)
  createdAt       DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime             @updatedAt @db.Timestamptz(3)

  assessments     ClaimAssessment[]

  @@unique([tenantId, id])
  @@unique([tenantId, claimCode])
  @@index([tenantId, vehicleId, status])
  @@schema("lashibi")
}

model ClaimAssessment {
  id              String   @id @default(cuid())
  tenantId        String
  claimId         String
  claim           InsuranceClaim @relation(fields: [tenantId, claimId], references: [tenantId, id], onDelete: Restrict)
  assessorName    String
  assessedAt      DateTime @db.Timestamptz(3)
  assessedAmount  Decimal? @db.Decimal(18, 2)
  approvedAmount  Decimal? @db.Decimal(18, 2)
  findings        Json?
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  @@index([tenantId, claimId, assessedAt])
  @@schema("lashibi")
}

// =============================================================================
// FINANCE / INVOICING / PAYMENTS / TAX
// =============================================================================

model Invoice {
  id              String            @id @default(cuid())
  tenantId        String
  customerId      String
  customer        Customer          @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict)
  invoiceNumber   String
  sourceType      InvoiceSourceType
  sourceId        String
  status          InvoiceStatus     @default(DRAFT)
  currencyCode    String            @default("GHS") @db.VarChar(3)
  subtotal        Decimal           @db.Decimal(18, 2)
  taxAmount       Decimal           @default(0) @db.Decimal(18, 2)
  discountAmount  Decimal           @default(0) @db.Decimal(18, 2)
  totalAmount     Decimal           @db.Decimal(18, 2)
  amountPaid      Decimal           @default(0) @db.Decimal(18, 2)
  amountDue       Decimal           @db.Decimal(18, 2)
  issuedAt        DateTime?         @db.Timestamptz(3)
  dueAt           DateTime?         @db.Timestamptz(3)
  classification  Classification    @default(CONFIDENTIAL)
  createdAt       DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @db.Timestamptz(3)

  lines           InvoiceLine[]
  allocations     PaymentAllocation[]
  taxSubmissions  TaxSubmission[]

  @@unique([tenantId, id])
  @@unique([tenantId, invoiceNumber])
  @@index([tenantId, status, dueAt])
  @@index([tenantId, sourceType, sourceId])
  @@schema("lashibi")
}

model InvoiceLine {
  id              String   @id @default(cuid())
  tenantId        String
  invoiceId       String
  invoice         Invoice  @relation(fields: [tenantId, invoiceId], references: [tenantId, id], onDelete: Restrict)
  description     String
  quantity        Decimal  @default(1) @db.Decimal(12, 3)
  unitPrice       Decimal  @db.Decimal(18, 2)
  amount          Decimal  @db.Decimal(18, 2)
  taxCode         String?
  taxRate         Decimal? @db.Decimal(9, 6)
  sourceLineType  String?
  sourceLineId    String?

  @@index([tenantId, invoiceId])
  @@schema("lashibi")
}

model Payment {
  id              String        @id @default(cuid())
  tenantId        String
  paymentCode     String
  method          PaymentMethod
  status          PaymentStatus @default(PENDING)
  currencyCode    String        @default("GHS") @db.VarChar(3)
  amount          Decimal       @db.Decimal(18, 2)
  payerName       String?
  payerReference  String?
  provider        String?
  providerReference String?
  receivedById    String?
  receivedAt      DateTime?     @db.Timestamptz(3)
  classification  Classification @default(CONFIDENTIAL)
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @db.Timestamptz(3)

  allocations     PaymentAllocation[]
  refunds         Refund[]
  providerTransactions PaymentProviderTransaction[]

  @@unique([tenantId, id])
  @@unique([tenantId, paymentCode])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, provider, providerReference])
  @@schema("lashibi")
}

model PaymentAllocation {
  id              String   @id @default(cuid())
  tenantId        String
  paymentId       String
  payment         Payment  @relation(fields: [tenantId, paymentId], references: [tenantId, id], onDelete: Restrict)
  invoiceId       String
  invoice         Invoice  @relation(fields: [tenantId, invoiceId], references: [tenantId, id], onDelete: Restrict)
  amount          Decimal  @db.Decimal(18, 2)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  @@unique([tenantId, paymentId, invoiceId])
  @@index([tenantId, invoiceId])
  @@schema("lashibi")
}

model Refund {
  id                String       @id @default(cuid())
  tenantId          String
  paymentId         String
  payment           Payment      @relation(fields: [tenantId, paymentId], references: [tenantId, id], onDelete: Restrict)
  refundCode        String
  status            RefundStatus @default(REQUESTED)
  amount            Decimal      @db.Decimal(18, 2)
  reason            String
  requestedById     String
  approvalRequestId String?
  providerReference String?
  processedAt       DateTime?    @db.Timestamptz(3)
  createdAt         DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime     @updatedAt @db.Timestamptz(3)

  @@unique([tenantId, id])
  @@unique([tenantId, refundCode])
  @@index([tenantId, status, createdAt])
  @@schema("lashibi")
}

model PaymentProviderTransaction {
  id              String        @id @default(cuid())
  tenantId        String
  paymentId       String
  payment         Payment       @relation(fields: [tenantId, paymentId], references: [tenantId, id], onDelete: Restrict)
  provider        String
  transactionType String
  externalId      String
  status          PaymentStatus
  amount          Decimal       @db.Decimal(18, 2)
  requestPayload  Json?
  responsePayload Json?
  occurredAt      DateTime      @default(now()) @db.Timestamptz(3)

  @@unique([tenantId, provider, externalId])
  @@index([tenantId, paymentId, occurredAt])
  @@schema("lashibi")
}

model TaxSubmission {
  id              String              @id @default(cuid())
  tenantId        String
  invoiceId       String
  invoice         Invoice             @relation(fields: [tenantId, invoiceId], references: [tenantId, id], onDelete: Restrict)
  provider        String              @default("GRA")
  status          TaxSubmissionStatus @default(QUEUED)
  externalReference String?
  requestHash     String?
  responseCode    String?
  responseSummary String?
  attemptCount    Int                 @default(0)
  lastAttemptAt   DateTime?           @db.Timestamptz(3)
  acceptedAt      DateTime?           @db.Timestamptz(3)
  createdAt       DateTime            @default(now()) @db.Timestamptz(3)

  @@index([tenantId, invoiceId, status])
  @@index([tenantId, status, lastAttemptAt])
  @@schema("lashibi")
}

// =============================================================================
// COMMUNICATIONS / INTEGRATIONS / API
// =============================================================================

model CommunicationLog {
  id              String                 @id @default(cuid())
  tenantId        String
  customerId      String?
  customer        Customer?              @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict)
  channel         CommunicationChannel
  direction       CommunicationDirection
  recipient       String?
  sender          String?
  templateCode    String?
  subject         String?
  contentSummary  String?
  provider        String?
  providerMessageId String?
  status          String
  sourceType      String?
  sourceId        String?
  classification  Classification         @default(CONFIDENTIAL)
  occurredAt      DateTime               @default(now()) @db.Timestamptz(3)

  @@index([tenantId, customerId, occurredAt])
  @@index([tenantId, sourceType, sourceId])
  @@schema("lashibi")
}

model ApiClient {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  name            String
  clientId        String
  secretHashRef   String?
  scopes          String[]
  active          Boolean  @default(true)
  expiresAt       DateTime? @db.Timestamptz(3)
  lastUsedAt      DateTime? @db.Timestamptz(3)
  metadata        Json?
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  @@unique([tenantId, clientId])
  @@index([tenantId, active])
  @@schema("lashibi")
}

model IntegrationConnection {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  type            String
  provider        String
  name            String
  status          String
  credentialRef   String?
  config          Json?
  lastHealthAt    DateTime? @db.Timestamptz(3)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  webhookEndpoints WebhookEndpoint[]

  @@unique([tenantId, id])
  @@index([tenantId, type, status])
  @@schema("lashibi")
}

model WebhookEndpoint {
  id              String   @id @default(cuid())
  tenantId        String
  integrationId   String
  integration     IntegrationConnection @relation(fields: [tenantId, integrationId], references: [tenantId, id], onDelete: Restrict)
  direction       String
  eventPattern    String
  endpointUrl     String?
  signingKeyRef   String?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  deliveries      WebhookDelivery[]

  @@unique([tenantId, id])
  @@index([tenantId, integrationId, active])
  @@schema("lashibi")
}

model WebhookDelivery {
  id              String   @id @default(cuid())
  tenantId        String
  endpointId      String
  endpoint        WebhookEndpoint @relation(fields: [tenantId, endpointId], references: [tenantId, id], onDelete: Restrict)
  eventId         String
  attempt         Int      @default(1)
  signatureValid  Boolean?
  replayRejected  Boolean  @default(false)
  httpStatus      Int?
  responseSummary String?
  sentAt          DateTime? @db.Timestamptz(3)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  @@unique([tenantId, endpointId, eventId, attempt])
  @@index([tenantId, endpointId, createdAt])
  @@schema("lashibi")
}

// =============================================================================
// AI / DECISION INTELLIGENCE
// =============================================================================

model AiRun {
  id                  String         @id @default(cuid())
  tenantId            String
  requestedById       String
  purpose             String
  sourceType          String?
  sourceId            String?
  provider            String
  modelName           String
  promptHash          String?
  inputClassification Classification @default(CONFIDENTIAL)
  outputClassification Classification @default(CONFIDENTIAL)
  status              AiRunStatus    @default(QUEUED)
  policyDecisionId    String?
  resultSummary       String?
  confidence          Decimal?       @db.Decimal(5, 4)
  humanReviewRequired Boolean        @default(false)
  humanReviewedAt     DateTime?      @db.Timestamptz(3)
  startedAt           DateTime?      @db.Timestamptz(3)
  completedAt         DateTime?      @db.Timestamptz(3)
  createdAt           DateTime       @default(now()) @db.Timestamptz(3)

  findings            AiFinding[]

  @@unique([tenantId, id])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, sourceType, sourceId])
  @@schema("lashibi")
}

model AiFinding {
  id              String   @id @default(cuid())
  tenantId        String
  aiRunId         String
  aiRun           AiRun    @relation(fields: [tenantId, aiRunId], references: [tenantId, id], onDelete: Restrict)
  type            String
  title           String
  detail          String?
  severity        IncidentSeverity?
  confidence      Decimal? @db.Decimal(5, 4)
  evidence        Json?
  accepted        Boolean?
  reviewedById    String?
  reviewedAt      DateTime? @db.Timestamptz(3)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  @@index([tenantId, aiRunId])
  @@schema("lashibi")
}
