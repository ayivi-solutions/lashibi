  reason          String?
  createdAt       DateTime                @default(now()) @db.Timestamptz(3)
  releasedAt      DateTime?               @db.Timestamptz(3)

  @@index([tenantId, reservationId, status])
  @@index([tenantId, vehicleId, allocatedFrom, allocatedUntil])
  @@schema("lashibi")
}

model RentalAgreement {
  id                    String                @id @default(cuid())
  tenantId              String
  reservationId         String
  reservation           RentalReservation     @relation(fields: [tenantId, reservationId], references: [tenantId, id], onDelete: Restrict)
  branchId              String
  branch                Branch                @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  customerId            String
  customer              Customer              @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict)
  vehicleId             String
  vehicle               Vehicle               @relation(fields: [tenantId, vehicleId], references: [tenantId, id], onDelete: Restrict)
  handledById           String
  handledBy             User                  @relation(fields: [tenantId, handledById], references: [tenantId, id], onDelete: Restrict)
  agreementCode         String
  rentalType            RentalType
  status                RentalAgreementStatus @default(DRAFT)
  renterNameSnapshot    String
  renterPhoneSnapshot   String?
  scheduledPickupAt     DateTime              @db.Timestamptz(3)
  actualPickupAt        DateTime?             @db.Timestamptz(3)
  dueReturnAt           DateTime              @db.Timestamptz(3)
  actualReturnAt        DateTime?             @db.Timestamptz(3)
  currencyCode          String                @default("GHS") @db.VarChar(3)
  baseDailyRate         Decimal               @db.Decimal(18, 2)
  agreedDays            Int
  includedKmTotal       Int?
  excessKmRate          Decimal?              @db.Decimal(18, 2)
  driverDailyRate       Decimal?              @db.Decimal(18, 2)
  deliveryCharge        Decimal               @default(0) @db.Decimal(18, 2)
  insuranceCharge       Decimal               @default(0) @db.Decimal(18, 2)
  discountAmount        Decimal               @default(0) @db.Decimal(18, 2)
  taxAmount             Decimal               @default(0) @db.Decimal(18, 2)
  depositRequired       Decimal               @default(0) @db.Decimal(18, 2)
  grossAmount           Decimal               @db.Decimal(18, 2)
  classification        Classification        @default(RESTRICTED)
  createdAt             DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime              @updatedAt @db.Timestamptz(3)

  driverAssignments     RentalDriverAssignment[]
  extensions            RentalExtension[]
  charges               RentalCharge[]
  deposits              RentalDeposit[]
  incidents             RentalIncident[]
  fines                 RentalFine[]
  tolls                 RentalToll[]
  reconciliations       RentalReturnReconciliation[]
  inspections           VehicleInspection[]

  @@unique([tenantId, id])
  @@unique([tenantId, agreementCode])
  @@index([tenantId, branchId, status, dueReturnAt])
  @@index([tenantId, vehicleId, status])
  @@index([tenantId, customerId, createdAt])
  @@schema("lashibi")
}

model RentalDriverAssignment {
  id              String                 @id @default(cuid())
