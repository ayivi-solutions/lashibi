// =============================================================================
// COUNTRY PACK / TENANT / ORGANISATION
// =============================================================================

model CountryPack {
  code             String   @id @db.VarChar(2)
  name             String
  currencyCode     String   @db.VarChar(3)
  defaultTimezone  String
  locale           String
  config           Json
  active           Boolean  @default(true)
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @db.Timestamptz(3)

  tenants          Tenant[]
  taxRules         TaxRule[]

  @@schema("lashibi")
}

model TaxRule {
  id              String   @id @default(cuid())
  countryPackCode String   @db.VarChar(2)
  countryPack     CountryPack @relation(fields: [countryPackCode], references: [code], onDelete: Restrict)
  code            String
  name            String
  rate            Decimal  @db.Decimal(9, 6)
  compoundOrder   Int      @default(0)
  effectiveFrom   DateTime @db.Timestamptz(3)
  effectiveTo     DateTime? @db.Timestamptz(3)
  active          Boolean  @default(true)

  @@unique([countryPackCode, code, effectiveFrom])
  @@schema("lashibi")
}

model Tenant {
  id              String       @id @default(cuid())
  name            String
  slug            String       @unique
  status          TenantStatus @default(ACTIVE)
  countryPackCode String       @default("GH") @db.VarChar(2)
  countryPack     CountryPack  @relation(fields: [countryPackCode], references: [code], onDelete: Restrict)
  timezone        String       @default("Africa/Accra")
  createdAt       DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @db.Timestamptz(3)
  archivedAt      DateTime?    @db.Timestamptz(3)

  branches        Branch[]
  users           User[]
  roles           RoleDefinition[]
  customers       Customer[]
  vehicles        Vehicle[]
  suppliers       Supplier[]
  parts           Part[]
  apiClients      ApiClient[]
  integrations    IntegrationConnection[]

  @@schema("lashibi")
}

model Branch {
  id          String     @id @default(cuid())
  tenantId    String
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  code        String
  name        String
  type        BranchType
  timezone    String     @default("Africa/Accra")
  active      Boolean    @default(true)
  address     Json?
  createdAt   DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @db.Timestamptz(3)

  vehicles             Vehicle[]
  stockLocations        StockLocation[]
  workBays              WorkBay[]
  userMemberships       UserBranchMembership[]
  rentalReservations    RentalReservation[]
  rentalAgreements      RentalAgreement[]
  workshopJobs          WorkshopJob[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId, active])
  @@schema("lashibi")
}

// =============================================================================
// IDENTITY, RBAC / ABAC, SCOPE, SoD, APPROVAL, PAM
// =============================================================================

model User {
  id            String      @id @default(cuid())
  tenantId      String
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  authUserId    String      @db.Uuid
  email         String
  name          String
  status        UserStatus  @default(INVITED)
  clearance     Classification @default(INTERNAL)
  primaryBranchId String?
  active        Boolean     @default(true)
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime    @updatedAt @db.Timestamptz(3)
  archivedAt    DateTime?   @db.Timestamptz(3)

  roles                    UserRole[]
  branchMemberships        UserBranchMembership[]
  employeeProfile          EmployeeProfile?
  sessions                 SecuritySession[]
  devices                  DeviceRegistration[]
  approvalRequestsMade     ApprovalRequest[]
  approvalDecisionsMade    ApprovalDecision[]
  temporaryAccessGrants    TemporaryAccessGrant[]
  breakGlassSessions       BreakGlassSession[]
  rentalReservationsCreated RentalReservation[]
  rentalAgreementsHandled  RentalAgreement[]

  @@unique([tenantId, id])
  @@unique([tenantId, authUserId])
  @@unique([tenantId, email])
  @@index([tenantId, status])
  @@schema("lashibi")
}

model UserBranchMembership {
  id          String   @id @default(cuid())
  tenantId    String
  userId      String
  user        User     @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Restrict)
  branchId    String
  branch      Branch   @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  isPrimary   Boolean  @default(false)
  startsAt    DateTime @default(now()) @db.Timestamptz(3)
  endsAt      DateTime? @db.Timestamptz(3)

  @@unique([tenantId, userId, branchId])
  @@index([tenantId, branchId])
  @@schema("lashibi")
}

model RoleDefinition {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  code        String
  name        String
  description String?
  builtIn     Boolean  @default(false)
  privileged  Boolean  @default(false)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  permissions RolePermission[]
  assignments UserRole[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@schema("lashibi")
}

model Permission {
  id          String   @id @default(cuid())
  code        String   @unique
  domain      String
  action      String
  description String?
  sensitive   Boolean  @default(false)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  rolePermissions RolePermission[]
  temporaryGrants TemporaryAccessGrant[]
  sodAsA           SoDPolicy[] @relation("SoDPermissionA")
  sodAsB           SoDPolicy[] @relation("SoDPermissionB")

  @@index([domain, action])
  @@schema("lashibi")
}

model RolePermission {
  id           String           @id @default(cuid())
  tenantId     String
  roleId       String
  role         RoleDefinition   @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Cascade)
  permissionId String
  permission   Permission       @relation(fields: [permissionId], references: [id], onDelete: Restrict)
  effect       PermissionEffect @default(ALLOW)
  condition    Json?
  createdAt    DateTime         @default(now()) @db.Timestamptz(3)

  @@unique([tenantId, roleId, permissionId])
  @@index([permissionId])
  @@schema("lashibi")
}

model UserRole {
  id          String   @id @default(cuid())
  tenantId    String
  userId      String
  user        User     @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Restrict)
  roleId      String
  role        RoleDefinition @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Restrict)
  startsAt    DateTime @default(now()) @db.Timestamptz(3)
  expiresAt   DateTime? @db.Timestamptz(3)
  grantedById String?
  reason      String?
  active      Boolean  @default(true)

  scopes      ScopeGrant[]

  @@unique([tenantId, id])
  @@index([tenantId, userId, active])
  @@index([tenantId, roleId])
  @@schema("lashibi")
}

model ScopeGrant {
  id            String    @id @default(cuid())
  tenantId      String
  userRoleId    String
  userRole      UserRole  @relation(fields: [tenantId, userRoleId], references: [tenantId, id], onDelete: Cascade)
  scopeType     ScopeType
  branchId      String?
  resourceType  String?
  resourceId    String?
  corporateAccountId String?
  condition     Json?
  startsAt      DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt     DateTime? @db.Timestamptz(3)
  active        Boolean   @default(true)

  @@index([tenantId, userRoleId, active])
  @@index([tenantId, branchId])
  @@index([tenantId, resourceType, resourceId])
  @@schema("lashibi")
}

model SoDPolicy {
  id              String   @id @default(cuid())
  tenantId        String
  code            String
  permissionAId   String
  permissionA     Permission @relation("SoDPermissionA", fields: [permissionAId], references: [id], onDelete: Restrict)
  permissionBId   String
  permissionB     Permission @relation("SoDPermissionB", fields: [permissionBId], references: [id], onDelete: Restrict)
  description     String
  makerChecker    Boolean  @default(true)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  @@unique([tenantId, code])
  @@index([permissionAId])
  @@index([permissionBId])
  @@schema("lashibi")
}

model ApprovalPolicy {
  id                    String   @id @default(cuid())
  tenantId              String
  code                  String
  actionPattern         String
  resourceType          String?
  minimumApprovals      Int      @default(1)
  makerCheckerRequired  Boolean  @default(true)
  stepUpRequired        Boolean  @default(false)
  approverPermission    String
  amountThreshold       Decimal? @db.Decimal(18, 2)
  classificationFloor   Classification?
  active                Boolean  @default(true)
  createdAt             DateTime @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime @updatedAt @db.Timestamptz(3)

  @@unique([tenantId, code])
  @@index([tenantId, actionPattern, active])
  @@schema("lashibi")
}

model ApprovalRequest {
  id                String         @id @default(cuid())
  tenantId          String
  policyCode        String?
  action            String
  resourceType      String?
  resourceId        String?
  classification    Classification @default(RESTRICTED)
  requestedById     String
  requestedBy       User           @relation(fields: [tenantId, requestedById], references: [tenantId, id], onDelete: Restrict)
  reason             String
  payload            Json?
  status             ApprovalStatus @default(PENDING)
  requiredApprovals  Int            @default(1)
  expiresAt          DateTime?       @db.Timestamptz(3)
  createdAt          DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime        @updatedAt @db.Timestamptz(3)

  decisions          ApprovalDecision[]
  temporaryGrants    TemporaryAccessGrant[]

  @@unique([tenantId, id])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, resourceType, resourceId])
  @@schema("lashibi")
}

model ApprovalDecision {
  id              String               @id @default(cuid())
  tenantId        String
  approvalRequestId String
  approvalRequest ApprovalRequest      @relation(fields: [tenantId, approvalRequestId], references: [tenantId, id], onDelete: Restrict)
  approverId      String
  approver        User                 @relation(fields: [tenantId, approverId], references: [tenantId, id], onDelete: Restrict)
  decision        ApprovalDecisionType
  reason          String?
  stepUpSessionId String?
  createdAt       DateTime             @default(now()) @db.Timestamptz(3)

  @@unique([tenantId, approvalRequestId, approverId])
  @@index([tenantId, approverId])
  @@schema("lashibi")
}

model TemporaryAccessGrant {
  id                String               @id @default(cuid())
  tenantId          String
  userId            String
  user              User                 @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Restrict)
  permissionId      String
  permission        Permission           @relation(fields: [permissionId], references: [id], onDelete: Restrict)
  scopeType         ScopeType
  branchId          String?
  resourceType      String?
  resourceId        String?
  approvalRequestId String?
  approvalRequest   ApprovalRequest?     @relation(fields: [tenantId, approvalRequestId], references: [tenantId, id], onDelete: Restrict)
  status            TemporaryGrantStatus @default(PENDING)
  startsAt          DateTime             @db.Timestamptz(3)
  expiresAt         DateTime             @db.Timestamptz(3)
  revokedAt         DateTime?            @db.Timestamptz(3)
  reason            String
