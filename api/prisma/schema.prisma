// Lashibi OS — Enterprise Prisma Schema
// PostgreSQL via Supabase, application schema: lashibi
//
// Security doctrine:
// 1. Supabase Auth owns authentication credentials. No password hashes are stored here.
// 2. Authorization is RBAC + ABAC: role, permission, scope, assignment/ownership,
//    classification, session assurance, delegation, SoD and approval policy.
// 3. tenantId is carried throughout protected data for RLS and composite-FK isolation.
// 4. Audit/auth-decision/evidence ledgers are append-only by database policy.
// 5. High-volume telemetry is designed for PostgreSQL time partitioning in SQL migrations.
// 6. Prisma cannot express every CHECK/RLS/trigger/partition rule; see companion migration notes.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["lashibi"]
}

