model InspectionTemplate {
  id            String   @id @default(cuid())
  tenantId      String
  code          String
  name          String
  context       InspectionContext
  version       Int      @default(1)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  items         InspectionTemplateItem[]
  inspections   VehicleInspection[]

  @@unique([tenantId, id])
  @@unique([tenantId, code, version])
  @@schema("lashibi")
}

model InspectionTemplateItem {
  id          String   @id @default(cuid())
  tenantId    String
  templateId  String
  template    InspectionTemplate @relation(fields: [tenantId, templateId], references: [tenantId, id], onDelete: Restrict)
  code        String
  label       String
  category    String
  required    Boolean  @default(true)
  sortOrder   Int
  config      Json?

  findings    InspectionFinding[]

  @@unique([tenantId, templateId, code])
  @@index([tenantId, templateId, sortOrder])
  @@schema("lashibi")
}

model VehicleInspection {
  id                String           @id @default(cuid())
  tenantId          String
  vehicleId         String
  vehicle           Vehicle          @relation(fields: [tenantId, vehicleId], references: [tenantId, id], onDelete: Restrict)
  templateId        String
  template          InspectionTemplate @relation(fields: [tenantId, templateId], references: [tenantId, id], onDelete: Restrict)
  context           InspectionContext
  status            InspectionStatus @default(DRAFT)
  rentalAgreementId String?
  workshopJobId     String?
  vehicleSaleId     String?
  performedById     String
  startedAt         DateTime         @default(now()) @db.Timestamptz(3)
  completedAt       DateTime?        @db.Timestamptz(3)
  odometerKm        Int?
  fuelPercent       Decimal?         @db.Decimal(5, 2)
  latitude          Decimal?         @db.Decimal(9, 6)
  longitude         Decimal?         @db.Decimal(9, 6)
  customerSignature Json?
  classification    Classification   @default(RESTRICTED)

  findings          InspectionFinding[]
  media             InspectionMedia[]
  damages           DamageRecord[]
  rentalAgreement   RentalAgreement? @relation(fields: [tenantId, rentalAgreementId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, vehicleId, context, startedAt])
  @@index([tenantId, rentalAgreementId])
  @@schema("lashibi")
}

model InspectionFinding {
  id              String        @id @default(cuid())
  tenantId        String
  inspectionId    String
  inspection      VehicleInspection @relation(fields: [tenantId, inspectionId], references: [tenantId, id], onDelete: Restrict)
