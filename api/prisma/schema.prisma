  listing         VehicleSaleListing? @relation(fields: [tenantId, listingId], references: [tenantId, id], onDelete: Restrict)
  status          SalesLeadStatus @default(NEW)
  source          String?
  assignedToId    String?
  notes           String?
  createdAt       DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @db.Timestamptz(3)

  @@unique([tenantId, id])
  @@index([tenantId, status, createdAt])
  @@schema("lashibi")
}

model TestDrive {
  id              String   @id @default(cuid())
  tenantId        String
  customerId      String
  customer        Customer @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict)
  vehicleId       String
  vehicle         Vehicle  @relation(fields: [tenantId, vehicleId], references: [tenantId, id], onDelete: Restrict)
  scheduledAt     DateTime @db.Timestamptz(3)
  startedAt       DateTime? @db.Timestamptz(3)
  endedAt         DateTime? @db.Timestamptz(3)
  supervisedById  String?
  outcome         String?
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  @@index([tenantId, vehicleId, scheduledAt])
  @@index([tenantId, customerId])
  @@schema("lashibi")
}

model VehicleSale {
  id              String            @id @default(cuid())
  tenantId        String
  customerId      String
  customer        Customer          @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict)
  vehicleId       String
  vehicle         Vehicle           @relation(fields: [tenantId, vehicleId], references: [tenantId, id], onDelete: Restrict)
  saleCode        String
  status          VehicleSaleStatus @default(DRAFT)
  currencyCode    String            @default("GHS") @db.VarChar(3)
  salePrice       Decimal           @db.Decimal(18, 2)
  discountAmount  Decimal           @default(0) @db.Decimal(18, 2)
  taxAmount       Decimal           @default(0) @db.Decimal(18, 2)
  totalAmount     Decimal           @db.Decimal(18, 2)
  handledById     String
  reservedAt      DateTime?         @db.Timestamptz(3)
  paidAt          DateTime?         @db.Timestamptz(3)
  handedOverAt    DateTime?         @db.Timestamptz(3)
  createdAt       DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @db.Timestamptz(3)

