  templateItem    InspectionTemplateItem @relation(fields: [templateItemId], references: [id], onDelete: Restrict)
  status          FindingStatus
  value           Json?
  notes           String?
  severity        IncidentSeverity?
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)

  @@unique([tenantId, inspectionId, templateItemId])
  @@schema("lashibi")
}

model InspectionMedia {
  id              String   @id @default(cuid())
  tenantId        String
  inspectionId    String
