model RentalReservation {
  id                    String            @id @default(cuid())
  tenantId              String
  branchId              String
  branch                Branch            @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  customerId            String
  customer              Customer          @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict)
  reservationCode       String
  rentalType            RentalType
  status                ReservationStatus @default(DRAFT)
  pickupLocation        Json?
  returnLocation        Json?
  scheduledPickupAt     DateTime          @db.Timestamptz(3)
  scheduledReturnAt     DateTime          @db.Timestamptz(3)
  requestedVehicleClass String?
  requestedDriver       Boolean           @default(false)
  currencyCode          String            @default("GHS") @db.VarChar(3)
  quotedAmount          Decimal?          @db.Decimal(18, 2)
