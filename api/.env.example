# Supabase Postgres connection (from your Supabase project settings)
DATABASE_URL="postgresql://user:password@host:5432/postgres?schema=lashibi"

# Supabase Auth (Project Settings -> API)
SUPABASE_URL="https://xxxx.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"

# API-issued session JWT — generate with: openssl rand -base64 48
SESSION_JWT_SECRET="replace-me"

PORT=3001
WEB_ORIGIN="http://localhost:3000"
NODE_ENV="development"
